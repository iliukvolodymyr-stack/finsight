# App
APP_ENV=local                  # local | staging | prod | demo
DEMO_MODE=false
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://tauri.localhost,tauri://localhost

# Auth
AUTH_MODE=single_user          # single_user (курсова) | jwt (диплом)
JWT_SECRET=change-me-32-chars-min-secure-secret-key-12345
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Data
DATABASE_URL=postgresql+asyncpg://finsight:finsight@127.0.0.1:5433/finsight
REDIS_URL=redis://127.0.0.1:6379/0
STORAGE_BACKEND=local          # local (курсова) | s3 (диплом)
ARTIFACTS_DIR=./var/artifacts
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET_MODELS=models
S3_BUCKET_DATASETS=datasets
S3_BUCKET_REPORTS=reports

# Market data
BINANCE_REST=https://api.binance.com
BINANCE_WS=wss://stream.binance.com:9443
ALPHAVANTAGE_API_KEY=
YAHOO_ENABLED=true

# News / LLM
CRYPTOPANIC_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
OPENROUTER_API_KEY=
LLM_SENTIMENT_MODEL=deepseek/deepseek-v4.1-flash
LLM_ASSISTANT_MODEL=google/gemini-3.8-flash
LLM_DAILY_BUDGET_USD=2.00
LLM_CACHE_TTL_DAYS=30

# Mobile
EXPO_ACCESS_TOKEN=

# Observability
SENTRY_DSN=
METRICS_TOKEN=
