    "/api/v1/instruments/{id}/refresh": {
      "post": {
        "tags": [
          "Instruments"
        ],
        "summary": "Refresh Instrument",
        "description": "Force incremental candle refresh with Redis distributed lock and 60s cooldown.",
        "operationId": "refresh_instrument_api_v1_instruments__id__refresh_post",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          },
          {
            "name": "timeframe",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(1h|1d)$",
              "default": "1h",
              "title": "Timeframe"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
